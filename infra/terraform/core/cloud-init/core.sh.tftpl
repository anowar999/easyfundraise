#!/usr/bin/env bash
# Bootstraps the easyfundraise-core box: Docker + Compose plugin, a deploy
# directory, and swap (so image pulls/compose on a small box don't OOM).
# The actual app is deployed by the GitHub Actions workflow over SSH.
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y ca-certificates curl gnupg

# Docker Engine + compose plugin (official repo).
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" \
  > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

systemctl enable docker
usermod -aG docker ubuntu || true

# 2G swap for headroom on small instances.
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# Deploy target. The workflow uploads core-compose.yml and .env here, then runs
# `docker compose up -d`.
mkdir -p /opt/easyfundraise
chown ubuntu:ubuntu /opt/easyfundraise

# Record the db endpoint so the operator / deploy can find it.
echo "DB_HOST=${db_host}" > /opt/easyfundraise/db-endpoint.env
chown ubuntu:ubuntu /opt/easyfundraise/db-endpoint.env

echo "core bootstrap complete"
