# Template for the .env the deploy workflow writes to the core box.
# Real values come from GitHub Actions secrets (see .github/workflows/deploy-core.yml);
# this file documents every key. DO NOT put real secrets here.

# --- Images (set by the workflow) ---------------------------------------------
IMAGE_API=ghcr.io/anowar999/easyfundraise-api
IMAGE_WEB=ghcr.io/anowar999/easyfundraise-web
IMAGE_TAG=latest

# --- Runtime ------------------------------------------------------------------
EF_ENV=prod
EF_DOMAIN=efcore.doctra.ai
EF_WEB_ORIGIN=https://efcore.doctra.ai
EF_TRACKING_BASE_URL=https://efcore.doctra.ai/api

# --- Database (points at the easyfundraise-db box private IP) ------------------
EF_DATABASE_URL=postgresql+psycopg://ef:CHANGE_ME@10.20.2.x:5432/easyfundraise

# --- Secrets (required in prod) -----------------------------------------------
EF_SECRET_KEY=change-me
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
EF_TOKEN_KEY=

# --- App config ---------------------------------------------------------------
EF_ADMIN_EMAILS=
EF_DEV_LOGIN=false
EF_API_WORKERS=2

# --- Paid integrations (optional) ---------------------------------------------
ANTHROPIC_API_KEY=
EF_GOOGLE_CLIENT_ID=
EF_GOOGLE_CLIENT_SECRET=
EF_GMAIL_MODE=google
EF_SMTP_HOST=
EF_SMTP_PORT=587
EF_SMTP_USER=
EF_SMTP_PASSWORD=
EF_SMTP_FROM=EasyFundraise <hello@easyfundraise.com>
EF_STRIPE_SECRET_KEY=
EF_STRIPE_WEBHOOK_SECRET=
