EF_ENV=dev
EF_DATABASE_URL=postgresql+psycopg://ef:ef@localhost:5432/easyfundraise
EF_SECRET_KEY=change-me
EF_WEB_ORIGIN=http://localhost:3000
# Google OAuth (Sign in with Google). Redirect URI: <EF_WEB_ORIGIN>/api/auth/google/callback
EF_GOOGLE_CLIENT_ID=
EF_GOOGLE_CLIENT_SECRET=
# Passwordless dev sign-in; always off when EF_ENV=prod
EF_DEV_LOGIN=true
# Comma-separated emails that become admins on sign-in
EF_ADMIN_EMAILS=
