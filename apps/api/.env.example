EF_ENV=dev
EF_DATABASE_URL=postgresql+psycopg://ef:ef@localhost:5432/easyfundraise
EF_SECRET_KEY=change-me
EF_WEB_ORIGIN=http://localhost:3000
# Google OAuth (Sign in with Google). Redirect URI: <EF_WEB_ORIGIN>/api/auth/google/callback
EF_GOOGLE_CLIENT_ID=
EF_GOOGLE_CLIENT_SECRET=
# Passwordless dev sign-in; always off when EF_ENV=prod
EF_DEV_LOGIN=true
# Comma-separated emails that become admins on sign-in
EF_ADMIN_EMAILS=
# AUTH-03 token encryption key: 32 random bytes, base64 (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
# Required in prod. In dev it is derived from EF_SECRET_KEY.
EF_TOKEN_KEY=
# Gmail sending. "google" uses the Gmail API (add redirect URI <EF_WEB_ORIGIN>/api/gmail/callback and enable the Gmail API);
# "fake" records sends locally so you can try the whole flow without Google (dev only).
EF_GMAIL_MODE=fake
# Public URL prefix for the open-tracking pixel (dedicated subdomain in prod, e.g. https://t.easyfundraise.com)
EF_TRACKING_BASE_URL=http://localhost:3000/api
# AI: set ANTHROPIC_API_KEY to turn on Claude drafting, briefs, chat and deck parsing. Without it the
# deterministic template engine is used everywhere.
ANTHROPIC_API_KEY=
EF_AI_MODEL_FRONTIER=claude-opus-5-5
EF_AI_MODEL_SMALL=claude-haiku-5-5
# Stripe billing (Checkout + Customer Portal). Webhook endpoint: <API>/billing/webhook
EF_STRIPE_SECRET_KEY=
EF_STRIPE_WEBHOOK_SECRET=
# Force admin two-factor outside prod (always on in prod)
EF_ADMIN_MFA=false
